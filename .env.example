# Sunucuda bu dosyayı .env olarak kopyalayıp TÜM değerleri değiştirin. .env asla GitHub'a gönderilmez.

# Alan adı (DNS A kaydı sunucunun IP'sini göstermeli)
DOMAIN=randevuhazir.com.tr

# Veritabanı
DB_USER=randevuhazir
DB_PASSWORD=guclu-bir-sifre-yazin
DB_NAME=randevuhazir

# Oturum imzalama anahtarı: en az 32 karakter, rastgele (openssl rand -base64 48)
JWT_KEY=en-az-32-karakterlik-rastgele-bir-anahtar-yazin

# İlk Comodo yönetici hesabı (ilk açılışta oluşturulur; sonra değiştirmek için hesaptan)
ADMIN_EMAIL=yonetici@comodo.com.tr
ADMIN_PASSWORD=en-az-8-karakter-guclu-sifre

# Şifre sıfırlama e-postaları için kurumsal e-posta hesabı (SMTP). Boş bırakılırsa e-posta gönderilmez.
SMTP_HOST=smtp.alanadiniz.com.tr
SMTP_PORT=587
SMTP_USER=bildirim@alanadiniz.com.tr
SMTP_PASSWORD=eposta-sifresi
SMTP_FROM=RandevuHazır <bildirim@alanadiniz.com.tr>

# Yalnız yerel geliştirme (docker-compose.yml tek başına)
DB_PORT=5432
API_PORT=8080
CORS_ORIGIN=http://127.0.0.1:5317
# Gerçek sunucuda mutlaka false (prod dosyası zaten false yapar).
DEMO_ALLOW_RESET=false
# Ekran testleri çok giriş yapar; yalnız yerelde yükseltin
AUTH_PER_MINUTE=10
