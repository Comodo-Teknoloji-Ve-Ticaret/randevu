<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <httpErrors>
      <remove statusCode="400" />
      <error statusCode="400" path="C:\websites\exobor.com.tr\error_docs\bad_request.html" />
      <remove statusCode="401" />
      <error statusCode="401" path="C:\websites\exobor.com.tr\error_docs\unauthorized.html" />
      <remove statusCode="403" />
      <error statusCode="403" path="C:\websites\exobor.com.tr\error_docs\forbidden.html" />
      <remove statusCode="404" />
      <error statusCode="404" path="C:\websites\exobor.com.tr\error_docs\not_found.html" />
      <remove statusCode="405" />
      <error statusCode="405" path="C:\websites\exobor.com.tr\error_docs\method_not_allowed.html" />
      <remove statusCode="406" />
      <error statusCode="406" path="C:\websites\exobor.com.tr\error_docs\not_acceptable.html" />
      <remove statusCode="407" />
      <error statusCode="407" path="C:\websites\exobor.com.tr\error_docs\proxy_authentication_required.html" />
      <remove statusCode="412" />
      <error statusCode="412" path="C:\websites\exobor.com.tr\error_docs\precondition_failed.html" />
      <remove statusCode="414" />
      <error statusCode="414" path="C:\websites\exobor.com.tr\error_docs\request-uri_too_long.html" />
      <remove statusCode="415" />
      <error statusCode="415" path="C:\websites\exobor.com.tr\error_docs\unsupported_media_type.html" />
      <remove statusCode="500" />
      <error statusCode="500" path="C:\websites\exobor.com.tr\error_docs\internal_server_error.html" />
      <remove statusCode="501" />
      <error statusCode="501" path="C:\websites\exobor.com.tr\error_docs\not_implemented.html" />
      <remove statusCode="502" />
      <error statusCode="502" path="C:\websites\exobor.com.tr\error_docs\bad_gateway.html" />
      <remove statusCode="503" />
      <error statusCode="503" path="C:\websites\exobor.com.tr\error_docs\maintenance.html" />
    </httpErrors>
    <staticContent>
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
    </staticContent>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
    <tracing>
      <traceFailedRequests>
        <clear />
      </traceFailedRequests>
    </tracing>
  </system.webServer>
  <system.web>
    <compilation tempDirectory="C:\websites\exobor.com.tr\tmp" />
  </system.web>
  <!-- Yönlendirmeler: /api alt uygulamasına miras geçmez (API yolları kısa link sanılmasın) -->
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <rewrite>
        <rules>
          <!-- randevunhazir.com.tr/<salon> → doğrudan salonun online randevu sayfası -->
          <rule name="comtr-kisa-link" stopProcessing="true">
            <match url="^([a-z0-9][a-z0-9-]{0,59})/?$" />
            <conditions logicalGrouping="MatchAll">
              <add input="{HTTP_HOST}" pattern="^(www\.)?randevunhazir\.com\.tr$" />
              <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
              <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            </conditions>
            <action type="Redirect" url="https://xn--randevunhazr-c5b.com/panel/#/r/{ToLower:{R:1}}" appendQueryString="false" redirectType="Found" />
          </rule>
          <!-- randevunhazir.com.tr/<her şey> → randevunhazır.com/<aynı yol> -->
          <rule name="comtr-ana-alan" stopProcessing="true">
            <match url="(.*)" />
            <conditions>
              <add input="{HTTP_HOST}" pattern="^(www\.)?randevunhazir\.com\.tr$" />
            </conditions>
            <action type="Redirect" url="https://xn--randevunhazr-c5b.com/{R:1}" redirectType="Permanent" />
          </rule>
          <!-- randevunhazır.com/<salon> → salonun online randevu sayfası -->
          <rule name="kisa-link" stopProcessing="true">
            <match url="^([a-z0-9][a-z0-9-]{0,59})/?$" />
            <conditions logicalGrouping="MatchAll">
              <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
              <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            </conditions>
            <action type="Redirect" url="/panel/#/r/{ToLower:{R:1}}" appendQueryString="false" redirectType="Found" />
          </rule>
        </rules>
      </rewrite>
    </system.webServer>
  </location>
</configuration>
